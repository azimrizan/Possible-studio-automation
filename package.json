{
  "name": "possible-studio-automation",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": ".venv/bin/uvicorn apps.api.app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir apps/api",
    "build:web": "npm --prefix apps/web run build",
    "start:web": "npm --prefix apps/web run start"
  }
}
