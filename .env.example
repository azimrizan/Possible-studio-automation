# ==============================================================================
# AI Marketing Employee — Environment Configuration (.env.example)
# All external integrations default to MOCK mode for zero-cost local runs.
# ==============================================================================

# Core Platform Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Master Encryption Key (AES-256 for local vault secrets)
APP_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Asymmetric Keypair for Cryptographic Approval Tokens (Ed25519)
# If empty, ephemeral keys will be generated automatically at boot for dev/test
APPROVAL_PRIVATE_KEY_HEX=
APPROVAL_PUBLIC_KEY_HEX=

# Database URLs (Postgres for Docker/Prod, SQLite fallback for local test)
DATABASE_URL=sqlite+aiosqlite:///./platform_data.db
POSTGRES_DB=possible_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Storage (Non-AWS POC)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=possible-studio-assets
MINIO_USE_SSL=false

# Port Allocations
API_PORT=8000
WEB_PORT=3000
MCP_GATEWAY_PORT=8100
MCP_HELLO_PORT=8101
MCP_MEDIA_PORT=8104
RENDER_SERVICE_PORT=8200

# Mock Mode Toggles (Set to true to run 100% offline without vendor credentials)
MOCK_EXTERNAL_APIS=true
MOCK_GEMINI=true
MOCK_META_GRAPH=true
MOCK_META_ADS=true
MOCK_WHATSAPP=true

# Vendor Credentials (Optional when MOCK_* is true)
GEMINI_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Poster Studio (Groq designer agent + Gemini multimodal rendering)
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
POSTER_DIRECTOR_REASONING_EFFORT=medium
POSTER_QA_ENABLED=true
# Leave empty to auto-pick the best Gemini image model the user's key exposes
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_SIZE=2K
STUDIO_DATA_DIR=
# Only for Google sign-in (OAuth): project that Gemini API calls are billed to
GOOGLE_CLOUD_PROJECT=

# Instagram + Meta Ads (Facebook Login for Business). Empty META_APP_ID or MOCK_META_GRAPH=true = demo mode.
META_GRAPH_VERSION=v24.0
# Optional: Facebook Login for Business configuration id (replaces the scope list)
META_LOGIN_CONFIG_ID=
# Hard cap enforced inside mcp-meta-ads (ad account currency, major units)
META_MAX_DAILY_BUDGET=50000
# Public HTTPS base URL of this app (Cloudflare Tunnel / ngrok in dev) so Instagram can download media
PUBLIC_ASSET_BASE_URL=
WEB_APP_URL=http://localhost:3000
DEFAULT_COUNTRY=IN

# Campaign strategist web research (free tiers). Leave both empty to skip web research.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
STRATEGIST_REASONING_EFFORT=medium
# Public https base for Meta's OAuth callback (required once the Meta app is Live)
META_REDIRECT_BASE_URL=
